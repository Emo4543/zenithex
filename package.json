{
  "name": "zenith",
  "version": "1.0.0",
  "description": "ZENITH - Game Launcher & FPS Booster",
  "author": "Zenith",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win zip"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.zenith.app",
    "productName": "ZENITH",
    "artifactName": "ZenithexApp.${ext}",
    "files": ["*.js", "*.html", "*.css", "package.json"],
    "win": { "target": "zip" }
  }
}
